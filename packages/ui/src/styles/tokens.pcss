/*
 * Design Tokens
 * Figma Styles 기반 디자인 토큰 정의
 *
 * 이 파일은 Color Token, Font Scale, Spacing System을 체계적으로 정의합니다.
 */

@theme {
  /* ============================================
     * COLOR TOKENS
     * ============================================ */

  /* Primary Colors */
  --color-primary-50: #fef4f2;
  --color-primary-100: #fcded9;
  --color-primary-200: #f8bdb3;
  --color-primary-300: #f49b8e;
  --color-primary-400: #f17967;
  --color-primary-500: #f04c28;
  --color-primary-600: #de4525;
  --color-primary-700: #b7391f;
  --color-primary-800: #8f2d18;
  --color-primary-900: #682012;

  /* Gray Scale */
  --color-gray-50: #fafafa;
  --color-gray-100: #f5f5f5;
  --color-gray-200: #eeeeee;
  --color-gray-300: #e0e0e0;
  --color-gray-400: #bdbdbd;
  --color-gray-500: #9e9e9e;
  --color-gray-600: #757575;
  --color-gray-700: #616161;
  --color-gray-800: #424242;
  --color-gray-900: #212121;

  /* Semantic Colors */
  --color-white: #fff;
  --color-black: #000;

  /* Status Colors - Success (기존) */
  --color-success-50: #f0fdf4;
  --color-success-100: #dcfce7;
  --color-success-200: #bbf7d0;
  --color-success-300: #86efac;
  --color-success-400: #4ade80;
  --color-success-500: #22c55e;
  --color-success-600: #16a34a;
  --color-success-700: #15803d;
  --color-success-800: #166534;
  --color-success-900: #14532d;

  /* Status Colors - Design System green */
  --color-green-50: #e8f5e9;
  --color-green-100: #c8e6c9;
  --color-green-200: #a5d6a7;
  --color-green-300: #81c784;
  --color-green-400: #66bb6a;
  --color-green-500: #2abb7f;
  --color-green-600: #4caf50;
  --color-green-700: #43a047;
  --color-green-800: #388e3c;
  --color-green-900: #1b5e20;

  /* Status Colors - Warning (기존)*/
  --color-warning-50: #fffbeb;
  --color-warning-100: #fef3c7;
  --color-warning-200: #fde68a;
  --color-warning-300: #fcd34d;
  --color-warning-400: #fbbf24;
  --color-warning-500: #f59e0b;
  --color-warning-600: #d97706;
  --color-warning-700: #b45309;
  --color-warning-800: #92400e;
  --color-warning-900: #78350f;

  /* Status Colors - Design System Yellor */
  --color-yellow-50: #fffbea;
  --color-yellow-100: #fff4b5;
  --color-yellow-200: #ffeba0;
  --color-yellow-300: #ffe18c;
  --color-yellow-400: #ffda7c;
  --color-yellow-500: #ffd569;
  --color-yellow-600: #ffcd5a;
  --color-yellow-700: #ffc54a;
  --color-yellow-800: #ffb636;
  --color-yellow-900: #ffa721;

  /* Status Colors - Error (기존)*/
  --color-error-50: #fef2f2;
  --color-error-100: #fee2e2;
  --color-error-200: #fecaca;
  --color-error-300: #fca5a5;
  --color-error-400: #f87171;
  --color-error-500: #ef4444;
  --color-error-600: #dc2626;
  --color-error-700: #b91c1c;
  --color-error-800: #991b1b;
  --color-error-900: #7f1d1d;

  /* Status Colors - Design System red */
  --color-red-50: #ffecec;
  --color-red-100: #ffc7c7;
  --color-red-200: #ffa6a6;
  --color-red-300: #ff7a7a;
  --color-red-400: #ff5252;
  --color-red-500: #ff2e2e;
  --color-red-600: #ff1717;
  --color-red-700: #ec0000;
  --color-red-800: #c70000;
  --color-red-900: #a00000;

  /* Status Colors - Info */
  --color-info-50: #eff6ff;
  --color-info-100: #dbeafe;
  --color-info-200: #bfdbfe;
  --color-info-300: #93c5fd;
  --color-info-400: #60a5fa;
  --color-info-500: #3b82f6;
  --color-info-600: #2563eb;
  --color-info-700: #1d4ed8;
  --color-info-800: #1e40af;
  --color-info-900: #1e3a8a;

  /* Brand Colors */
  --color-kakao: #fee500;
  --color-primary-orange-red: #f04c28;
  --color-subColor-pink: #feedea;
  --color-secondary-pink: #fdf1ee;
  --color-secondary-orange-red: #ed5f5f;

  /* Special Grays */
  --color-redGray-30: #f8f8f8;
  --color-redGray-50: #f8f8f8;
  --color-blueGray-30: #f4f7f9;
  --color-blueGray-50: #eceff1;

  /* ============================================
     * UNIT SYSTEM
     * ============================================
     * Figma spacing & radius 값 반영
     *
     */

  /* 공용 단위 */
  --unit-0: 0px;
  --unit-2: 2px;
  --unit-4: 4px;
  --unit-6: 6px;
  --unit-8: 8px;
  --unit-10: 10px;
  --unit-12: 12px;
  --unit-16: 16px;
  --unit-20: 20px;
  --unit-24: 24px;
  --unit-30: 30px;
  --unit-32: 32px;
  --unit-40: 40px;
  --unit-48: 48px;
  --unit-56: 56px;
  --unit-64: 64px;
  --unit-full: 999px;

  --spacing-0: var(--unit-0);
  --spacing-2: var(--unit-2);
  --spacing-4: var(--unit-4);
  --spacing-6: var(--unit-6);
  --spacing-8: var(--unit-8);
  --spacing-10: var(--unit-10);
  --spacing-12: var(--unit-12);
  --spacing-16: var(--unit-16);
  --spacing-20: var(--unit-20);
  --spacing-24: var(--unit-24);
  --spacing-30: var(--unit-30);
  --spacing-32: var(--unit-32);
  --spacing-40: var(--unit-40);
  --spacing-48: var(--unit-48);
  --spacing-56: var(--unit-56);
  --spacing-64: var(--unit-64);

  --radius-0: var(--unit-0);
  --radius-2: var(--unit-2);
  --radius-4: var(--unit-4);
  --radius-6: var(--unit-6);
  --radius-8: var(--unit-8);
  --radius-10: var(--unit-10);
  --radius-12: var(--unit-12);
  --radius-16: var(--unit-16);
  --radius-20: var(--unit-20);
  --radius-24: var(--unit-24);
  --radius-30: var(--unit-30);
  --radius-32: var(--unit-32);
  --radius-40: var(--unit-40);
  --radius-48: var(--unit-48);
  --radius-56: var(--unit-56);
  --radius-64: var(--unit-64);
  --radius-full: var(--unit-full);

  /* ============================================
     * HEIGHT SYSTEM
     * ============================================ */

  --height-button-sm: 30px;
  --height-button-md: 42px;
  --height-button-lg: 56px;
  --height-input: 42px;
  --height-header: 80px;
  --height-footer: 68px;

  /* ============================================
     * FONT SCALE
     * ============================================
     * Figma Text Styles 기반
     */

  /* Font Sizes */
  --font-size-10: 10px; /* 0.625rem */
  --font-size-11: 11px; /* 0.6875rem */
  --font-size-12: 12px; /* 0.75rem */
  --font-size-14: 14px; /* 0.875rem */
  --font-size-16: 16px; /* 1rem */
  --font-size-18: 18px; /* 1.125rem */
  --font-size-20: 20px; /* 1.25rem */
  --font-size-24: 24px; /* 1.5rem */

  /* Line Heights */
  --line-height-none: 1;
  --line-height-tight: 1.2;
  --line-height-snug: 1.3;
  --line-height-normal: 1.4;
  --line-height-relaxed: 1.5;
  --line-height-loose: 1.6;

  /* Letter Spacing */
  --letter-spacing-tighter: -0.06em;
  --letter-spacing-tight: -0.04em;
  --letter-spacing-normal: -0.02em;
  --letter-spacing-wide: 0em;
  --letter-spacing-wider: 0.02em;

  /* Font Weights */
  --font-weight-thin: 100;
  --font-weight-extralight: 200;
  --font-weight-light: 300;
  --font-weight-normal: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;
  --font-weight-extrabold: 800;
  --font-weight-black: 900;

  /* ============================================
     * SHADOW SYSTEM
     * ============================================ */

  --shadow-xs: 0px 1px 2px 0px rgba(0, 0, 0, 0.05);
  --shadow-sm:
    0px 1px 3px 0px rgba(0, 0, 0, 0.1), 0px 1px 2px 0px rgba(0, 0, 0, 0.06);
  --shadow-md:
    0px 2px 4px 0px rgba(0, 0, 0, 0.08), 0px 3px 10px 0px rgba(0, 0, 0, 0.1);
  --shadow-lg:
    0px 4px 6px -1px rgba(0, 0, 0, 0.1), 0px 2px 4px -1px rgba(0, 0, 0, 0.06);
  --shadow-xl:
    0px 10px 15px -3px rgba(0, 0, 0, 0.1), 0px 4px 6px -2px rgba(0, 0, 0, 0.05);
  --shadow-2xl:
    0px 20px 25px -5px rgba(0, 0, 0, 0.1),
    0px 10px 10px -5px rgba(0, 0, 0, 0.04);

  /* Component Specific Shadows */
  --shadow-toast:
    0px 2px 4px 0px rgba(0, 0, 0, 0.08), 0px 3px 10px 0px rgba(0, 0, 0, 0.1);
  --shadow-card: 0px 1px 3px 0px rgba(0, 0, 0, 0.1);

  /* ============================================
     * Z-INDEX SCALE
     * ============================================ */

  --z-base: 0;
  --z-dropdown: 1000;
  --z-sticky: 1020;
  --z-fixed: 1030;
  --z-modal-backdrop: 1040;
  --z-modal: 1050;
  --z-popover: 1060;
  --z-tooltip: 1070;
  --z-toast: 1080;

  /* ============================================
     * TRANSITION & ANIMATION
     * ============================================ */

  --transition-fast: 150ms ease-in-out;
  --transition-base: 200ms ease-in-out;
  --transition-slow: 300ms ease-in-out;
  --transition-colors: color 300ms ease-in-out;

  --animate-bell-shake: bell-shake 5s 0.1s ease-in-out;
  --animate-timer-shake: timer-shake 5s 0.1s ease-in-out;
  --animate-heart-pop: heart-pop 0.3s ease-in-out;

  @keyframes bell-shake {
    0% {
      transform: rotate(0);
    }
    1% {
      transform: rotate(30deg);
    }
    3% {
      transform: rotate(-28deg);
    }
    5% {
      transform: rotate(34deg);
    }
    7% {
      transform: rotate(-32deg);
    }
    9% {
      transform: rotate(30deg);
    }
    11% {
      transform: rotate(-28deg);
    }
    13% {
      transform: rotate(26deg);
    }
    15% {
      transform: rotate(-24deg);
    }
    17% {
      transform: rotate(22deg);
    }
    19% {
      transform: rotate(-20deg);
    }
    21% {
      transform: rotate(18deg);
    }
    23% {
      transform: rotate(-16deg);
    }
    27% {
      transform: rotate(-12deg);
    }
    31% {
      transform: rotate(-8deg);
    }
    33% {
      transform: rotate(6deg);
    }
    35% {
      transform: rotate(-4deg);
    }
    37% {
      transform: rotate(2deg);
    }
    39% {
      transform: rotate(-1deg);
    }
    41% {
      transform: rotate(1deg);
    }
    43% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(0deg);
    }
  }

  @keyframes timer-shake {
    0%,
    20%,
    100% {
      transform: rotate(0);
    }
    2%,
    6%,
    10% {
      transform: rotate(-10deg);
    }
    4%,
    8%,
    12% {
      transform: rotate(10deg);
    }
  }

  @keyframes heart-pop {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.3);
    }
    100% {
      transform: scale(1);
    }
  }
}
