/** 폰트 파일 로딩 전용 (Font Resources)
 * woff2를 우선적으로 사용하고, 지원 안 되는 브라우저에선 woff로 fallback
 *
 * 이 파일은 Pretendard 폰트 파일을 브라우저에 로드하기 위한 @font-face 선언만 포함합니다.
 *
 * 실제 텍스트 스타일이 필요하면 → typography.pcss의 text-* 유틸리티를 사용하세요.
*/

@font-face {
  font-family: 'Pretendard';
  src:
    url('../assets/fonts/pretendard/woff2-subset/Pretendard-Thin.subset.woff2')
      format('woff2'),
    url('../assets/fonts/pretendard/woff-subset/Pretendard-Thin.subset.woff')
      format('woff');
  font-weight: 100;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'Pretendard';
  src:
    url('../assets/fonts/pretendard/woff2-subset/Pretendard-ExtraLight.subset.woff2')
      format('woff2'),
    url('../assets/fonts/pretendard/woff-subset/Pretendard-ExtraLight.subset.woff')
      format('woff');
  font-weight: 200;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'Pretendard';
  src:
    url('../assets/fonts/pretendard/woff2-subset/Pretendard-Light.subset.woff2')
      format('woff2'),
