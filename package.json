{
  "name": "dessert-front-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@4.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:seller": "turbo run dev --filter=@dessert/seller",
    "dev:admin": "turbo run dev --filter=@dessert/admin",
    "build": "turbo run build",
    "build:seller": "turbo run build --filter=@dessert/seller",
    "build:admin": "turbo run build --filter=@dessert/admin",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "prepare": "husky",
    "storybook:ui": "turbo run storybook --filter=@dessert/ui",
    "storybook:icons": "turbo run storybook --filter=@dessert/icons",
    "build-storybook:ui": "turbo run build-storybook --filter=@dessert/ui",
    "build-storybook:icons": "turbo run build-storybook --filter=@dessert/icons"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-better-tailwindcss": "^4.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-storybook": "^0.12.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "prettier": "3.5.3",
    "turbo": "^2.8.15",
    "typescript-eslint": "^8.24.1"
  }
}
