{
  "name": "dessert-front-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@4.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:seller": "turbo run dev --filter=@dessert/seller",
    "dev:admin": "turbo run dev --filter=@dessert/admin",
    "build": "turbo run build",
    "build:seller": "turbo run build --filter=@dessert/seller",
    "build:admin": "turbo run build --filter=@dessert/admin",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "storybook:ui": "turbo run storybook --filter=@dessert/ui",
    "build-storybook:ui": "turbo run build-storybook --filter=@dessert/ui",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "3.5.3",
    "turbo": "^2.8.15"
  }
}
