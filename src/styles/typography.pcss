/*
 * Design Tokens (Legacy)
 *
 * 새로운 디자인 토큰은 src/styles/tokens.pcss를 참조하세요.
 * 이 파일은 하위 호환성을 위해 유지됩니다.
 *
 * shadcn 관련은 src/shared/lib/shadcn/styles/shadcn.pcss에 있습니다.
 */

@import './tokens.pcss';

/* Heading 24 */
@utility typo-heading-24-m {
  font-size: 24px;
  font-weight: 500;
  line-height: 160%;
  letter-spacing: -0.02em;
}

@utility typo-heading-24-sb {
  font-size: 24px;
  font-weight: 600;
  line-height: 160%;
  letter-spacing: -0.02em;
}

