staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
  exit 0
fi

echo "포맷 검사 중..."
printf '%s\n' "$staged" | tr '\n' '\0' | xargs -0 yarn prettier --check --ignore-unknown --no-error-on-unmatched-pattern || {
  echo ""
  echo "포맷이 맞지 않는 파일이 있습니다. yarn format 실행 후 다시 커밋하세요."
  exit 1
}
