{
  "$schema": "https://v2-8-15.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_API_BASE_URL"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},

    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["VITE_API_BASE_URL"]
    },

    "test:run": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["VITE_API_BASE_URL"]
    },

    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    }
  }
}
